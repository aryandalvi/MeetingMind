# Copy to backend/.env and adjust. All values are optional.

# Models (any compatible Hugging Face / spaCy model names)
MEETINGMIND_SUMMARIZER_MODEL=philschmid/distilbart-cnn-12-6-samsum
# Low-memory alternative (~560 MB): lidiya/bart-base-samsum
MEETINGMIND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEETINGMIND_SPACY_MODEL=en_core_web_sm

# abstractive (default) or extractive (no summarization model; fast, low memory)
MEETINGMIND_SUMMARY_MODE=abstractive
# Load models when the server starts instead of on the first analysis
MEETINGMIND_PRELOAD_MODELS=false
# auto | cpu | cuda
MEETINGMIND_DEVICE=auto

# Limits
MEETINGMIND_MAX_UPLOAD_MB=10
MEETINGMIND_MAX_TRANSCRIPT_CHARS=300000
MEETINGMIND_MIN_TRANSCRIPT_WORDS=15

# Comma-separated list of allowed frontend origins
MEETINGMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEETINGMIND_LOG_LEVEL=INFO
